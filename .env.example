# ==============================================================================
# DataPilot AI - Environment Variable Template
# Copy this file to .env and configure credentials for your deployment.
# Never commit actual API keys or secret credentials to GitHub.
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "mock" (auto-fallback if keys missing)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
# Default is SQLite for local zero-configuration execution:
DATABASE_URL=sqlite:///./data/datapilot.db
# For PostgreSQL production instances:
# DATABASE_URL=postgresql://user:password@localhost:5432/datapilot_db

# Security & Data Guardrails
MAX_FILE_SIZE_MB=15
MAX_ROWS=150000
MAX_COLUMNS=250
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Frontend URL (For Production CORS configuration)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-frontend.vercel.app"]
